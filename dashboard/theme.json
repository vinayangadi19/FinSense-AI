{
    "name": "Midnight Emerald Premium",
    "dataColors": [
        "#00E676",
        "#FF5252",
        "#29B6F6",
        "#FFD700",
        "#AB47BC",
        "#26A69A",
        "#FFA726",
        "#78909C"
    ],
    "background": "#0D1117",
    "foreground": "#ECEFF1",
    "tableAccent": "#00E676",
    "visualStyles": {
        "*": {
            "*": {
                "background": [
                    {
                        "show": true,
                        "color": {
                            "solid": {
                                "color": "#161B22"
                            }
                        },
                        "transparency": 0
                    }
                ],
                "border": [
                    {
                        "show": true,
                        "color": {
                            "solid": {
                                "color": "#30363D"
                            }
                        },
                        "radius": 12
                    }
                ],
                "visualHeader": [
                    {
                        "show": true,
                        "foreground": {
                            "solid": {
                                "color": "#ECEFF1"
                            }
                        },
                        "background": {
                            "solid": {
                                "color": "#161B22"
                            }
                        }
                    }
                ],
                "title": [
                    {
                        "show": true,
                        "fontColor": {
                            "solid": {
                                "color": "#FFFFFF"
                            }
                        },
                        "fontSize": 14,
                        "fontFamily": "Segoe UI Semibold",
                        "alignment": "Left"
                    }
                ]
            }
        },
        "card": {
            "*": {
                "labels": [
                    {
                        "show": true,
                        "color": {
                            "solid": {
                                "color": "#8B949E"
                            }
                        },
                        "fontSize": 10,
                        "fontFamily": "Segoe UI"
                    }
                ],
                "cardData": [
                    {
                        "color": {
                            "solid": {
                                "color": "#00E676"
                            }
                        },
                        "fontSize": 28,
                        "fontFamily": "Segoe UI Bold"
                    }
                ]
            }
        }
    }
}
